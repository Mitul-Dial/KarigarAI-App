#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets — share with teammates via password manager, not GitHub
/android/key.properties
/android/*.jks
/android/*.keystore

# Local env
.env
.env.*
!.env.example

# Firebase config files (contain API keys)
/android/app/google-services.json
/lib/firebase_options.dart
/firebase.json

# Supabase keys (copy from supabase_secrets.example.dart)
/lib/config/supabase_secrets.dart

# Android build artifacts
/android/build/
